<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<DialogPane fx:id="dialogPane"
            fx:controller="com.reminder.ui.controller.SettingsDialogController"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="640" prefHeight="620"
            headerText="%settings.header">
    <fx:define>
        <ToggleGroup fx:id="themeGroup"/>
        <ToggleGroup fx:id="exportModeGroup"/>
    </fx:define>
    <content>
        <HBox spacing="10">
            <ListView fx:id="sectionList" prefWidth="180"/>
            <StackPane HBox.hgrow="ALWAYS">
                <VBox fx:id="appearancePane" spacing="10">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                    <Label text="%settings.theme" style="-fx-font-weight: bold;"/>
                    <RadioButton fx:id="lightRadio" text="%settings.theme.light" toggleGroup="$themeGroup"/>
                    <RadioButton fx:id="darkRadio" text="%settings.theme.dark" toggleGroup="$themeGroup"/>
                </VBox>
                <VBox fx:id="generalPane" spacing="10">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                    <Label text="%settings.defaultType" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="typeChoice" visibleRowCount="15" maxWidth="Infinity"/>
                    <CheckBox fx:id="autostartCheck" text="%settings.autostart" wrapText="true"/>
                    <Button fx:id="openFolderButton" text="%settings.openFolder" maxWidth="Infinity"/>
                </VBox>
                <VBox fx:id="languagePane" spacing="10">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                    <Label text="%settings.language.label" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="languageChoice" maxWidth="Infinity"/>
                    <Label text="%settings.language.restartHint" styleClass="hint" wrapText="true"/>
                    <Button fx:id="restartButton" text="%settings.language.restart"/>
                    <Label fx:id="languageWarningLabel" wrapText="true"
                           style="-fx-text-fill: #f44336;" managed="false" visible="false"/>
                </VBox>
                <VBox fx:id="exportPane" spacing="10">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                    <Label text="%settings.export.decimal" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="decimalChoice" maxWidth="Infinity"/>

                    <Label text="%settings.export.folder" style="-fx-font-weight: bold;"/>
                    <HBox spacing="5">
                        <TextField fx:id="exportDirField" editable="false" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="exportDirButton" text="%settings.export.choose"/>
                        <Button fx:id="exportDirResetButton" text="%settings.export.reset"/>
                    </HBox>

                    <Label text="%settings.export.mode" style="-fx-font-weight: bold;"/>
                    <RadioButton fx:id="exportModeSuggestRadio" text="%settings.export.mode.suggest"
                                 toggleGroup="$exportModeGroup" wrapText="true"/>
                    <RadioButton fx:id="exportModeAlwaysRadio" text="%settings.export.mode.always"
                                 toggleGroup="$exportModeGroup" wrapText="true"/>

                    <Label text="%settings.export.formats" style="-fx-font-weight: bold;"/>
                    <VBox fx:id="formatChecks" spacing="5"/>

                    <CheckBox fx:id="exportOpenFolderCheck" text="%settings.export.openFolder" wrapText="true"/>
                </VBox>
                <VBox fx:id="updatesPane" spacing="10">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                    <CheckBox fx:id="updateCheckEnabledCheck" text="%settings.updates.enabled" wrapText="true"/>
                    <Label text="%settings.updates.time" style="-fx-font-weight: bold;"/>
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Spinner fx:id="updateHourSpinner" editable="true" maxWidth="80"/>
                        <Label text=":"/>
                        <Spinner fx:id="updateMinuteSpinner" editable="true" maxWidth="80"/>
                    </HBox>
                </VBox>
                <VBox fx:id="tasksPane" spacing="10">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                    <Label text="%settings.tasks.file" style="-fx-font-weight: bold;"/>
                    <HBox spacing="5">
                        <TextField fx:id="taskImportFileField" editable="false" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="taskImportFileButton" text="%settings.tasks.choose"/>
                        <Button fx:id="taskImportFileResetButton" text="%settings.tasks.reset"/>
                    </HBox>
                    <HBox spacing="5">
                        <Button fx:id="taskImportCreateExampleButton" text="%settings.tasks.createExample"/>
                    </HBox>
                    <Label fx:id="taskImportNoFileHint" text="%settings.tasks.noFileHint"
                           wrapText="true" styleClass="hint"/>
                    <CheckBox fx:id="taskImportOnStartupCheck" text="%settings.tasks.onStartup" wrapText="true"/>
                    <CheckBox fx:id="taskImportScheduleCheck" text="%settings.tasks.schedule" wrapText="true"/>
                    <Label fx:id="taskImportTimeLabel" text="%settings.tasks.time" style="-fx-font-weight: bold;"/>
                    <HBox fx:id="taskImportTimeBox" spacing="5" alignment="CENTER_LEFT">
                        <Spinner fx:id="taskImportHourSpinner" editable="true" maxWidth="80"/>
                        <Label text=":"/>
                        <Spinner fx:id="taskImportMinuteSpinner" editable="true" maxWidth="80"/>
                    </HBox>
                    <CheckBox fx:id="taskImportTrayNotifyCheck" text="%settings.tasks.notifyTray" wrapText="true"/>
                </VBox>
            </StackPane>
        </HBox>
    </content>
</DialogPane>
