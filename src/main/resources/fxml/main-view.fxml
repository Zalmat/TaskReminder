<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.reminder.ui.controller.MainController">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <fx:define>
        <ToggleGroup fx:id="viewGroup"/>
    </fx:define>

    <top>
        <VBox spacing="10" style="-fx-padding: 5 0 10 0;">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="%main.title"
                       style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                <Label fx:id="importBell" text="🔔" visible="false" managed="false"
                       style="-fx-font-size: 16px; -fx-cursor: hand;"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <RadioButton fx:id="dayRadio" text="%main.day" selected="true" toggleGroup="$viewGroup"/>
                <RadioButton fx:id="weekRadio" text="%main.week" toggleGroup="$viewGroup"/>
                <Button fx:id="prevButton" text="◀"/>
                <DatePicker fx:id="datePicker"/>
                <Button fx:id="nextButton" text="▶"/>
                <Button fx:id="todayButton" text="%main.today"/>
                <Separator orientation="VERTICAL"/>
                <Button fx:id="holidayButton" text="%main.holidays"/>
            </HBox>
        </VBox>
    </top>

    <left>
        <VBox spacing="10" prefWidth="320" styleClass="side-panel">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding> <!-- Внутри шутка
            <Label text="%main.title" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                -->
            <Label
                   text="%main.addWork"
                   onMouseClicked="#handleLabelClick"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <!-- Конец шутки -->
            <Label text="%main.label.project"/>
            <ComboBox fx:id="projectChoice" editable="true" visibleRowCount="15" promptText="%main.prompt.project" maxWidth="Infinity"/>

            <Label text="%main.label.task"/>
            <ComboBox fx:id="taskChoice" editable="true" visibleRowCount="15" promptText="%main.prompt.task" maxWidth="Infinity"/>

            <Label text="%main.label.type"/>
            <ComboBox fx:id="typeChoice" visibleRowCount="15" promptText="%main.prompt.type" maxWidth="Infinity"/>

            <VBox fx:id="indexingStatus" spacing="4" visible="false" managed="false">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <ProgressIndicator fx:id="indexingSpinner" prefWidth="18" prefHeight="18"/>
                    <Label fx:id="indexingLabel" text="%main.indexing" wrapText="true" styleClass="hint"/>
                </HBox>
                <ProgressBar fx:id="indexingProgress" maxWidth="Infinity" visible="false" managed="false"/>
            </VBox>

            <VBox fx:id="hoursContainer" spacing="5">
                <Label text="%main.label.hours"/>
                <TextField fx:id="hoursField" promptText="%main.prompt.hours"/>
            </VBox>

            <Label text="%main.label.comment"/>
            <TextArea fx:id="commentArea" prefRowCount="3" wrapText="true" promptText="%main.prompt.comment"/>

            <Button fx:id="addButton" text="%main.add" maxWidth="Infinity" styleClass="primary"/>

            <Separator/>

            <Button fx:id="loadYamlButton" text="%main.loadYaml" maxWidth="Infinity"/>
            <Button fx:id="templateButton" text="%main.downloadTemplate" maxWidth="Infinity"/>
            <Button fx:id="clearButton" text="%main.clearTable" maxWidth="Infinity" styleClass="danger"/>
        </VBox>
    </left>

    <center>
        <StackPane>
            <VBox fx:id="dayPanel" spacing="10" style="-fx-padding: 0 10 0 10;">
                <HBox spacing="20" alignment="CENTER_LEFT">
                    <Label fx:id="dayTotalLabel"
                           style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Label fx:id="dayRemainingLabel"
                           style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Label fx:id="dayOvertimeLabel"
                           style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                </HBox>
                <TableView fx:id="dayTableView" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="dayProjectColumn" text="%column.project" prefWidth="120"/>
                        <TableColumn fx:id="dayTaskColumn" text="%column.task" prefWidth="150"/>
                        <TableColumn fx:id="dayTypeColumn" text="%column.type" prefWidth="100"/>
                        <TableColumn fx:id="dayHoursColumn" text="%column.hours" prefWidth="70"/>
                        <TableColumn fx:id="dayCommentColumn" text="%column.comment" prefWidth="200"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox fx:id="weekPanel" spacing="8" visible="false" style="-fx-padding: 0 10 0 10;">
                <HBox spacing="20" alignment="CENTER_LEFT">
                    <Label fx:id="weekTotalLabel"
                           style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2196F3;"/>
                    <Label text="%main.weekEditHint"
                           styleClass="hint" style="-fx-font-size: 11px;"/>
                </HBox>
                <TableView fx:id="weekTableView" editable="true" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="weekProjectColumn" text="%column.project" prefWidth="120"/>
                        <TableColumn fx:id="weekTaskColumn" text="%column.task" prefWidth="150"/>
                        <TableColumn fx:id="weekTypeColumn" text="%column.typeWork" prefWidth="100"/>
                        <TableColumn fx:id="weekCommentColumn" text="%column.comment" prefWidth="150"/>
                        <TableColumn fx:id="weekTotalColumn" text="%column.total" prefWidth="70"/>
                    </columns>
                </TableView>
            </VBox>
        </StackPane>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
            <MenuButton text="☰">
                <items>
                    <MenuItem fx:id="settingsItem" text="%main.settings"/>
                </items>
            </MenuButton>
            <Separator orientation="VERTICAL"/>
            <Button fx:id="updateButton" text="%main.checkUpdates"/>
            <Button fx:id="reminderButton" text="%main.reminders"/>
            <Button fx:id="exportButton" text="%main.export"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Hyperlink text="GitHub Issues" onAction="#openGithubIssues" styleClass="github-link" style="-fx-padding: 0; -fx-underline: false; -fx-font-weight: bold;"/>
            <Label fx:id="clockLabel"/>
        </HBox>
    </bottom>
</BorderPane>
